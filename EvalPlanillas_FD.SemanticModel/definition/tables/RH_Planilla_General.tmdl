	column EsComercial = ```
			
			VAR _Existe = 
			    CALCULATE(
			        VALUES(RH_VariableMensual[Item]),
			        FILTER(
			            RH_VariableMensual,
			            RH_VariableMensual[Item] = RH_Planilla_General[Codigo] &&
			            RH_VariableMensual[Periodo] = RH_Planilla_General[Periodo]
			        )
			    )
			RETURN
			IF (
			    ISBLANK(_Existe),
			    "NO",
			    "SI"
			)
			```
		lineageTag: 87dca234-19f1-40ae-b646-92791852c8cd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

