			defaultHierarchy: LocalDateTable_b39a72b8-eab1-4f74-a980-30eeba7be049.'Jerarquía de fechas'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	partition Objetivos_Gest1-7ddb9363-efa7-408b-94d3-73e08ad7c814 = calculated
		mode: import
		source =
				var _vendedores = DISTINCT(union(CALCULATETABLE(values(Ventas[Vendedor]), YEAR(ventas[fecha]) = YEAR(TODAY()) - 1), CALCULATETABLE(values(Objetivos[Vendedor]), Objetivos[Gestion] = YEAR(TODAY()) - 1)))
				var _canales = FILTER(canales, Canales[CodCanal] <> 12)
				var _sucursales = filter(sucursales, Sucursales[SucursalReg] <> 0)
				var _fechas = CALCULATETABLE(VALUES(Fechas[AñoMes]), Fechas[Año] = year(TODAY()) - 1)
				return
				
				SELECTCOLUMNS(CROSSJOIN(_Vendedores, _canales, _sucursales, Lineas, _fechas), "Canal", Canales[CodCanal], "Sucursal", Sucursales[CodSuc], "CodVendedor", Ventas[Vendedor], "Linea", Lineas[Linea], "AñoMes", Fechas[AñoMes])

