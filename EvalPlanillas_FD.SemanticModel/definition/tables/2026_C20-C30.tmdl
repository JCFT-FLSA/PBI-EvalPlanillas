	column Presupuesto_2 = DIVIDE('2026_C20-C30'[Avance_2], '2026_C20-C30'[Objetivos_2], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 07200963-c3ee-481a-b1f3-163865ac12d9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Presupuesto_3 = ```
			
			VAR _Canal =
			    IF (
			        '2026_C20-C30'[Cargo] = "C30",
			        BLANK(),
			        20
			    )
			VAR _Mora = 
			    1 - DIVIDE (
			        '2026_C20-C30'[Avance_3],
			        '2026_C20-C30'[Objetivos_3],
			        0
			    )
			VAR _Valor = // Fomula generada por IA en base a Tablas de Valores 
			    IF (
			        _Mora >= 0.44,
			        0,
			        IF(
			            _Mora >= 0.4,
			            25 * (0.44 - _Mora),
			            IF(
			                _Mora < 0.35,
			                1.5,
			                ( 1 + 10 * ( 0.4 - _Mora) )
			
			            )
			        )
			    )
			Return
			    IF 
			        ( _Canal = 20, // Canal 20 & C20-30 tiene CxC como 3er objetivo
			            _Valor,
			            BLANK()
			        )
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: cf8fed0c-6a2f-443f-bc2d-b7a3fc1395e3
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

