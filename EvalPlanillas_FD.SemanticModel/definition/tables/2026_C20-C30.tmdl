	column KPI3_Valor = ```
			
			     // IVT Se rige por su cartera
			VAR _Vencido = 
			    SUMX(
			        FILTER(
			            FILTER(
			                FILTER (
			                    CxC,
			                    //CxC[IVT Cartera] = '2023_C20'[CodVendedor]
			                    CxC[Vendedor] = '2026_C20-C30'[CodVendedor]
			                ),
			                CxC[Periodo] = ENDOFQUARTER('2026_C20-C30'[AñoMes])
			            ),
			            CxC[neoRangoVencido] = "Vencido"
			        ),
			        CxC[Importe]
			    )
			
			VAR _Vigente = 
			    SUMX(
			        FILTER(
			            FILTER(
			                FILTER (
			                    CxC,
			                    //CxC[IVT Cartera] = '2023_C20'[CodVendedor]
			                    CxC[Vendedor] = '2026_C20-C30'[CodVendedor]
			                ),
			                CxC[Periodo] = ENDOFQUARTER('2026_SAC'[AñoMes])
			            ),
			            CxC[neoRangoVencido] = "Vigente"
			        ),
			        CxC[Importe]
			    )
			
			RETURN
			
			    IF (
			        '2026_C20-C30'[TKPI3] = BLANK(), 
			        BLANK(),
			        DIVIDE(_Vencido, _Vencido + _Vigente, -1)
			    )
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 29de0691-d908-4722-b66c-de5b37c5f996
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

