	column Objetivos_2 = ```
			// Objetivo Grupal para todos es el objetivo de su regional
			    SUMX(
			        FILTER(
			            Objetivos, 
			            Objetivos[Periodo] = '2026_C20-C30'[AñoMes] &&
			            Objetivos[Vendedor] = '2026_C20-C30'[CodVendedor]
			        ),
