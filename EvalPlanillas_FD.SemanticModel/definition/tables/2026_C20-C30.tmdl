		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Objetivos_3 = ```
			//Aplicable solo a C20 & C20-30
			    IF(
			        '2026_C20-C30'[Cargo] = "C30",
			        BLANK(),
			        CALCULATE( // Calcula las CxC de la cartera
			            SUM(CxC[Importe]),
			            FILTER (
			                CxC,
			                CxC[Periodo] = '2026_C20-C30'[AñoMes] &&
			                CxC[Vendedor] = '2026_C20-C30'[CodVendedor]
			            )
			        )
			    )
			
			```
		formatString: #,0.00
		lineageTag: 6b664528-307f-4562-91eb-017198b8ddb2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_1 = ```
			// Calcula el total Ventas con el Codigo de vendedor
			SUMX(
			    FILTER(
			        ventas, 
			        RELATED(Fechas[AñoMes]) = '2026_C20-C30'[AñoMes] &&
			        Ventas[Vendedor] = '2026_C20-C30'[CodVendedor]
			    ),
			    Ventas[Venta]
			)
			```
		formatString: #,0.00
		lineageTag: 3e686ed1-2fc0-4e6e-b1d1-823923a483fc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_2 = ```
			// Utilidad Bruta
			VAR _Costo =
			    SUMX(
			        FILTER(
			            Ventas, 
			            RELATED(Fechas[AñoMes]) = '2026_C20-C30'[AñoMes] && 
			            Ventas[Vendedor] = '2026_C20-C30'[CodVendedor]
			        ),
			        Ventas[Costo]
			    )
			RETURN
			    '2026_C20-C30'[Avance_1] - _Costo
			```
		formatString: #,0.00
		lineageTag: cb2c2701-402b-49ea-9f72-db8e29c2e31e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_3 =
			//Aplicable solo a C20 & C20-30
			    IF(
			        '2026_C20-C30'[Cargo] = "C30",
			        BLANK(),
			        CALCULATE( // Calcula las CxC de la cartera
			            SUM(CxC[Importe]),
			            FILTER (
			                CxC,
			                CxC[Periodo] = '2026_C20-C30'[AñoMes] &&
			                CxC[Rangos Vencidos] = "Vigente" &&
			                CxC[Vendedor] = '2026_C20-C30'[CodVendedor]
			            )
			        )
			    )
