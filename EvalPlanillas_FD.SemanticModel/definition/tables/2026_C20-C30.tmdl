	column Objetivos_4 = ```
			// Aplica a todos
			VAR 
			    _Canal = 
			        SWITCH(
			            '2026_C20-C30'[Cargo],
			            "C20", 20,
			            "C30", 30,
			            "C20-30", 30 // Inicialmete las visitas de C30
			        )
			
			RETURN
			    CALCULATE(
			        VALUES(RH_VisitasCRM[Visitas]),
			        FILTER(
			            RH_VisitasCRM,
			            RH_VisitasCRM[Canal] = _Canal &&
			            RH_VisitasCRM[Periodo] = '2026_C20-C30'[AñoMes]
			        )
			    )
			```
		formatString: 0
		lineageTag: 52fb131f-8a86-48f1-82df-0ab4733af6c1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_4 = ```
			
