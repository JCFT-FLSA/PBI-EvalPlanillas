	column Presupuesto_1 = DIVIDE('2026_C20-C30'[Avance_1], '2026_C20-C30'[Objetivos_1], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 3922348f-22b2-4fb9-8502-86a1a85751af
