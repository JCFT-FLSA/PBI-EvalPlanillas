table RH_Planilla_BonoTrimestral
	lineageTag: a9f1d6d8-ce40-4311-a301-1b7325ada953

	column KPI1_Valor = ```
			
			    CALCULATE(
			        VALUES(RH_Utilidad[Utilidad]), 
			        FILTER(
			            RH_Utilidad, 
			            RH_Utilidad[Cuarto] = RH_Planilla_BonoTrimestral[Cuarto]
			        )
			    )
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: c5096161-3227-4a3e-8843-c1a64556a4ea
		summarizeBy: sum

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

	column KPI1_Beneficio = ```
			
			VAR I5 = [KPI1_Valor]
			VAR _Valor = 
			    IF(
			        I5 > 1.2, 
			        1.5, 
			        IF(
			            I5 <= 0.8, 
			            0,
			            IF(
			                I5 <= 1,
			                5 * (I5 - 0.8),
			                1 + 2.5 * (I5 - 1)
			            )
			        )
			    )
			VAR _PesoTabla = 
			CALCULATE(
			    VALUES(RH_TablaKPI[Beneficio]), 
			    FILTER(
			        RH_TablaKPI, 
			        RH_TablaKPI[KPI] = RH_Planilla_BonoTrimestral[TKPI1] &&
			        RH_TablaKPI[Valor] = 1
			    ) 
			)
			
			RETURN
			    _Valor *_PesoTabla
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 52ed24ea-0d70-4d2c-9144-43582e039fad
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column KPI2_Valor = ```
			
			VAR _Obj = 
			    SUMX(
			        FILTER(
			            Objetivos,
			            RELATED(Fechas[nbTrimestreAño])= RH_Planilla_BonoTrimestral[Cuarto]
			        ),
			        Objetivos[ObjetivoBs]
			    )
			VAR _Vta = 
			    SUMX(
			        FILTER(
			            Ventas,
			            RELATED(Fechas[nbTrimestreAño])= RH_Planilla_BonoTrimestral[Cuarto]
			        ),
			        Ventas[Venta]
			    )
			
			RETURN
			    DIVIDE(
			        _Vta, 
			        _Obj, 
			        0
			    )        
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 66e55f8e-16da-4d94-8fab-7b16992746f6
