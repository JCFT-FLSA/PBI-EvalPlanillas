	partition RH_Planilla_BonoTrimestral-e9b89d45-3591-4ab9-8f56-9d9e464d86d0 = calculated
		mode: import
		source =
				UNION(
				    GROUPBY('2026_SDI', [Cuarto], [Item], [nbVendedor], [Cargo], [Regional], [Sucursal], [TKPI1], [TKPI2], [TKPI3], [TKPI4], [TKPI5]),
				    GROUPBY('2026_SAC', [Cuarto], [Item], [nbVendedor], [Cargo], [Regional], [Sucursal], [TKPI1], [TKPI2], [TKPI3], [TKPI4], [TKPI5]),
				    GROUPBY('2026_C20-C30', [Cuarto], [Item], [nbVendedor], [Cargo], [Regional], [Sucursal], [TKPI1], [TKPI2], [TKPI3], [TKPI4], [TKPI5]),
				    GROUPBY('2026_CANALES', [Cuarto], [Item], [nbVendedor], [Cargo], [Regional], [Sucursal], [TKPI1], [TKPI2], [TKPI3], [TKPI4], [TKPI5]),
				    GROUPBY('2026_G-VENTAS', [Cuarto], [Item], [nbVendedor], [Cargo], [Regional], [Sucursal], [TKPI1], [TKPI2], [TKPI3], [TKPI4], [TKPI5]),
				    GROUPBY('2026_G-MARKETING', [Cuarto], [Item], [nbVendedor], [Cargo], [Regional], [Sucursal], [TKPI1], [TKPI2], [TKPI3], [TKPI4], [TKPI5]),
				    GROUPBY('2026_C11', [Cuarto], [Item], [nbVendedor], [Cargo], [Regional], [Sucursal], [TKPI1], [TKPI2], [TKPI3], [TKPI4], [TKPI5]),
				    GROUPBY('2026_C10', [Cuarto], [Item], [nbVendedor], [Cargo], [Regional], [Sucursal], [TKPI1], [TKPI2], [TKPI3], [TKPI4], [TKPI5]),
				    GROUPBY('2026_TODOS', [Cuarto], [Item], [nbEmpleado], [Cargo], [Regional], [Oficina], [TKPI1], [TKPI2], [TKPI3], [TKPI4], [TKPI5])
				)

