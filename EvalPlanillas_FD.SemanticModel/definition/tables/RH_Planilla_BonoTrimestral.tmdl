		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: b860b2d3-ebe0-4a9b-b5d2-386143148594
		summarizeBy: sum

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

	column KPI3_Beneficio = ```
			
			VAR _Mora = [KPI3_Valor]
			
			VAR _Valor =
			    IF (
			        _Mora >= 0.44,
			        0,
			        IF(
			            _Mora >= 0.4,
			            25 * (0.44 - _Mora),
			            IF(
			                _Mora < 0.35,
			                1.5,
			                ( 1 + 10 * ( 0.4 - _Mora) )
			            )
			        )
			    )
			
			VAR _PesoTabla = 
			CALCULATE(
			    VALUES(RH_TablaKPI[Beneficio]), 
			    FILTER(
			        RH_TablaKPI, 
			        RH_TablaKPI[KPI] = RH_Planilla_BonoTrimestral[TKPI3] &&
			        RH_TablaKPI[Valor] = 0.4
			    ) 
			)
			
			RETURN
			_Valor * _PesoTabla
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: c29b4fa4-8b90-4e25-8e4d-600d6a6d4f61
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Total_Beneficios = RH_Planilla_BonoTrimestral[KPI1_Beneficio] + RH_Planilla_BonoTrimestral[KPI2_Beneficio] + RH_Planilla_BonoTrimestral[KPI3_Beneficio] + RH_Planilla_BonoTrimestral[KPI4_Beneficio]
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: a8879020-cfc4-41ca-8f5a-729806da76d2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column KPI4_Beneficio = ```
			
			VAR _Valor =
			    RH_Planilla_BonoTrimestral[KPI4_Valor]
			
			VAR _Gestion = 2026
			    //RH_Planilla_BonoTrimestral[Gestion]
			
			VAR _Q =
			    LEFT ( RH_Planilla_BonoTrimestral[Cuarto], 2 )
			
			VAR _KPI =
			    RH_Planilla_BonoTrimestral[TKPI4] & "-" & _Q
			
			VAR _TablaRango =
			    FILTER (
			        RH_TablaKPI,
			        RH_TablaKPI[Gestion] = _Gestion
			            && RH_TablaKPI[KPI] = _KPI
			            && NOT ISBLANK ( RH_TablaKPI[Valor] )
			            && NOT ISBLANK ( RH_TablaKPI[Beneficio] )
			    )
			
			VAR _PuntoInf =
			    TOPN (
			        1,
			        FILTER ( _TablaRango, RH_TablaKPI[Valor] <= _Valor ),
			        RH_TablaKPI[Valor], DESC
			    )
			
			VAR _PuntoSup =
			    TOPN (
			        1,
			        FILTER ( _TablaRango, RH_TablaKPI[Valor] >= _Valor ),
			        RH_TablaKPI[Valor], ASC
			    )
			
			VAR _ValorInf =
			    MAXX ( _PuntoInf, RH_TablaKPI[Valor] )
			
			VAR _ValorSup =
			    MAXX ( _PuntoSup, RH_TablaKPI[Valor] )
			
			VAR _BeneficioInf =
			    MAXX ( _PuntoInf, RH_TablaKPI[Beneficio] )
			
			VAR _BeneficioSup =
			    MAXX ( _PuntoSup, RH_TablaKPI[Beneficio] )
			
			RETURN
			    SWITCH (
			        TRUE (),
			
			        ISBLANK ( _Valor ), BLANK (),
			
			        ISBLANK ( _ValorInf ) && NOT ISBLANK ( _ValorSup ), _BeneficioSup,
			
			        NOT ISBLANK ( _ValorInf ) && ISBLANK ( _ValorSup ), _BeneficioInf,
			
			        _ValorInf = _ValorSup, _BeneficioInf,
			
			        _BeneficioInf
			            + DIVIDE (
			                _Valor - _ValorInf,
			                _ValorSup - _ValorInf
			            )
			            * ( _BeneficioSup - _BeneficioInf )
			    )
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 1a271c99-5961-4223-b500-142deffc73a7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column KPI3_Valor =
			
			VAR _Mes =
			    CALCULATE(
			        MAX(Fechas[AñoMes]),
			        FILTER(
			            Fechas,
			            Fechas[NbTrimestreAño] = RH_Planilla_BonoTrimestral[Cuarto]
			        )
			    )
			
			VAR _TotalCartera =
			    CALCULATE(
			        SUM(CxC[Importe]),
			        FILTER (
			            CxC,
			            CxC[Periodo] = _Mes
			        )
			    )
			
			VAR _Vigente =
			    CALCULATE(
			        SUM(CxC[Importe]),
			        FILTER (
			            CxC,
			            CxC[Periodo] = _Mes &&
			            CxC[Rangos Vencidos] = "Vigente"
			        )
			    )
			
			RETURN
			    1 - DIVIDE(
			        _Vigente,
			        _TotalCartera
			    )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 1cb43470-d03b-4f8b-8527-001f257ccecd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column KPI4_Valor =
			
			VAR _Cuarto =
			    RH_Planilla_BonoTrimestral[Cuarto]
			RETURN
			    CALCULATE (
			        AVERAGE ( RH_NivelServicio[NivelServicio] ),
			        RH_NivelServicio[Cuarto] = _Cuarto,
			        NOT ISBLANK ( RH_NivelServicio[NivelServicio] )
			    )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 42243148-841a-4ae3-82ca-0843dca7cad6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

