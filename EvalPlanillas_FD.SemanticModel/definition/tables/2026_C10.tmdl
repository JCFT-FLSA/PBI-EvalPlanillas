	column FactorGestActual = SUMX(FILTER('DiasValidosxMes', 'DiasValidosxMes'[Periodo] = '2026_C10'[AñoMes]), 'DiasValidosxMes'[Factor])
		lineageTag: 447f0122-7d27-45dc-bad9-fb040e4ea81c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column FactorGestAnterior = SUMX(FILTER('DiasValidosxMes', 'DiasValidosxMes'[Periodo] = DATEADD('2026_C10'[AñoMes], - [Valor Gestiones Previas], YEAR)), 'DiasValidosxMes'[Factor])
		lineageTag: 54ed4c8b-dc02-4b70-8744-5a4022fc1105
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Objetivos_1 = ```
			// EDV & PDV resultado de su sucursal
			SUMX(
			        FILTER(
			            FILTER(
			                FILTER(
			                    Objetivos, 
			                    Objetivos[Periodo] = '2026_C10'[AñoMes]), 
			                Objetivos[Canal] = 10), 
			            Objetivos[Sucursal] = '2026_C10'[CodSuc]), 
			        Objetivos[ObjetivoBs]
			    )
			
			```
		formatString: #,0.00
		lineageTag: 720474c4-44e3-4d48-a75a-710576f09421
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Objetivos_2 = ```
			
			    SUMX(
			        FILTER(
			            Objetivos, 
			            Objetivos[Periodo] = '2026_C10'[AñoMes] &&
			            Objetivos[Canal] = 10 &&
			            Objetivos[Sucursal] = '2026_C10'[CodSuc]), 
			        Objetivos[UtilidadObjBs]
			    )
			
			
			
			```
		formatString: #,0.00
		lineageTag: 8f4c35b6-c359-490c-816c-22bfd2864d4b
