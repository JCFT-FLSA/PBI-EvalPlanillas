	column Avance_1 = ```
			
			SUMX(
			        FILTER(
			            FILTER(
			                FILTER(
			                    ventas, 
			                    RELATED(Fechas[AñoMes]) = '2026_C10'[AñoMes]), 
			                Ventas[Canal distribución] = 10), 
			            RELATED(Sucursales[CodSuc]) = '2026_C10'[CodSuc]), 
			        Ventas[Venta]
			    ) 
			```
		formatString: #,0.00
		lineageTag: 8290ca33-ac6b-442d-b3a6-3808a8e82c3f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_2 = ```
			
			VAR _Costo = 
			    SUMX(
			        FILTER(
			            FILTER(
			                FILTER(
			                    ventas, 
			                    RELATED(Fechas[AñoMes]) = '2026_C10'[AñoMes]), 
			                Ventas[Canal distribución] = 10), 
			            RELATED(Sucursales[CodSuc]) = '2026_C10'[CodSuc]), 
			        Ventas[Costo]
			    )
			RETURN
			'2026_C10'[Avance_1] - _Costo
			    
			```
		formatString: #,0.00
		lineageTag: 973f7252-6e1f-41ef-b587-2e51671b5f32
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

