	partition 2026_TODOS = calculated
		mode: import
		source = ```
				
				     ADDCOLUMNS( 
				            SELECTCOLUMNS( 
				                FILTER(
				                    RH_Planilla_General,
				                     RH_Planilla_General[EsComercial] = "NO" &&
				                     YEAR(RH_Planilla_General[Periodo]) = 2026
				                ),
				                "Periodo", [Periodo], 
				                "Item", [Codigo], 
				                "Cargo", [CargoCorto], 
				                "nbEmpleado", [nbEmpleado], 
				                "Oficina", [CodSuc], 
				                "Regional", [Region], 
				                "EsComercial", [EsComercial]
				            ),
				            "TKPI1", "TU1", 
				            "TKPI2", "TV6", 
				            "TKPI3", "TM3", 
				            "TKPI4", "NS",  
				            "TKPI5", BLANK()
				        )
				```

	annotation PBI_Id = 62dbc3dc2a5a47bf8d404410a00c0d74

