		variation Variación
			isDefault
			relationship: 7376e97a-2cb8-4fb8-8af3-9c9db0e01891
			defaultHierarchy: LocalDateTable_0b17cdbf-9dfd-4182-a049-d6b42b260abb.'Jerarquía de fechas'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	partition Objetivos_Gest2-6305c177-86d9-40fb-a2a9-e6c340ba7f7a = calculated
		mode: import
		source =
				
				var _vendedores = DISTINCT(union(CALCULATETABLE(values(Ventas[Vendedor]), YEAR(ventas[fecha]) = YEAR(TODAY()) -2), CALCULATETABLE(values(Objetivos[Vendedor]), Objetivos[Gestion] = YEAR(TODAY()) -2)))
				var _canales = FILTER(canales, Canales[CodCanal] <> 12)
				var _sucursales = filter(sucursales, Sucursales[SucursalReg] <> 0)
				var _fechas = CALCULATETABLE(VALUES(Fechas[AñoMes]), Fechas[Año] = year(TODAY()) - 2)
				return
				
				SELECTCOLUMNS(CROSSJOIN(_Vendedores, _canales, _sucursales, Lineas, _fechas), "Canal", Canales[CodCanal], "Sucursal", Sucursales[CodSuc], "CodVendedor", Ventas[Vendedor], "Linea", Lineas[Linea], "AñoMes", Fechas[AñoMes])

