	column FactorGestActual = ```
			
			    SUMX (
			        FILTER (
			            'DiasValidosxMes',
			            'DiasValidosxMes'[Periodo] = '2026_SAC'[AñoMes]
			        ),
			        'DiasValidosxMes'[Factor]
			    )
			```
		formatString: 0
		lineageTag: 73a9bf2c-59aa-4dc9-aabd-ce96c9db90e6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column FactorGestAnterior = SUMX(FILTER('DiasValidosxMes', 'DiasValidosxMes'[Periodo] = DATEADD('2026_C11'[AñoMes], - [Valor Gestiones Previas], YEAR)), 'DiasValidosxMes'[Factor])
		formatString: 0
		lineageTag: c0c58095-ca29-4547-b66a-318cfb12a36f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Objetivos_1 =
			// Objetivos de C11 de la Regional
			    IF(
			        '2026_SAC'[Cargo] = "SAC",
			        SUMX(
			            FILTER(
			                Objetivos,
			                Objetivos[Periodo] = '2026_SAC'[AñoMes] &&
			                Objetivos[Regional] = '2026_SAC'[Regional] &&
			                Objetivos[Canal] = 11
			            ),
			            Objetivos[ObjetivoBs]
			        ),
			        SUMX(
			            FILTER(
			                Objetivos,
			                Objetivos[Periodo] = '2026_SAC'[AñoMes] &&
			                Objetivos[Canal] = 11
			            ),
			            Objetivos[ObjetivoBs]
			        )
			    )
		formatString: #,0.00
		lineageTag: 8ea7b7fb-cc48-4cfb-bbfc-34c83394d28b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Objetivos_2 = ```
			
			     IF(
			        '2026_SAC'[Cargo] = "SAC",
			        SUMX(
			            FILTER(
			                Objetivos,
			                Objetivos[Periodo] = '2026_SAC'[AñoMes] &&
			                Objetivos[Regional] = '2026_SAC'[Regional] &&
			                Objetivos[Canal] = 11
			            ),
			            Objetivos[UtilidadObjBs]
			        ),
			        SUMX(
			            FILTER(
			                Objetivos,
			                Objetivos[Periodo] = '2026_SAC'[AñoMes] &&
			                Objetivos[Canal] = 11
			            ),
			            Objetivos[UtilidadObjBs]
			        )
			    )
			```
		lineageTag: 3f5c3404-329e-4de3-978d-3ddae65378e9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Objetivos_3 =
			// Calcula el total de la cartera de la reginoal de canal 11 a aprtir de 01/2024
			    Blank()
		formatString: #,0
		lineageTag: c82ebb24-65a1-4dee-8dce-5ba1bddd0f75
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_1 = ```
			
			  IF(
			        '2026_SAC'[Cargo] = "SAC",
			        SUMX(
			            FILTER(
			                Ventas,
			                RELATED(Fechas[AñoMes]) = '2026_SAC'[AñoMes] &&
			                RELATED(Sucursales[SucursalReg]) = '2026_SAC'[Regional] &&
			                RELATED(Canales[CodCanal]) = 11
			            ),
			            Ventas[Venta]
			        ),
			        SUMX(
			            FILTER(
			                Ventas,
			                RELATED(Fechas[AñoMes]) = '2026_SAC'[AñoMes] &&
			                RELATED(Canales[CodCanal]) = 11
			            ),
			            Ventas[Venta]
			        )
			    )
			```
		formatString: #,0.00
		lineageTag: 0e417966-7e55-46a9-9971-0a70d74f1214
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_2 =
			
			VAR _Costo =
			    IF(
			        '2026_SAC'[Cargo] = "SAC",
			        SUMX(
			            FILTER(
			                    Ventas,
			                    RELATED(Fechas[AñoMes]) = '2026_SAC'[AñoMes] &&
			                    RELATED(Sucursales[SucursalReg]) = '2026_SAC'[Regional] &&
			                    Ventas[Canal distribución] = 11
			            ),
			            Ventas[Costo]
			        ),
			        SUMX(
			            FILTER(
			                Ventas,
			                RELATED(Fechas[AñoMes]) = '2026_SAC'[AñoMes] &&
			                Ventas[Canal distribución] = 11
			            ),
			            Ventas[Costo]
			        )
			    )
			RETURN
			    '2026_SAC'[Avance_1] - _Costo
		lineageTag: f5c07fbf-7324-4d65-855e-70df4d07754f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Avance_3 =
			// Calcula el valor de la cartera VIGENTE de la reginoal de canal 11
			    BLANK()
		formatString: #,0
		lineageTag: fbb60d1b-0699-481b-9050-0f5a8439795d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Presupuesto_1 = ```
			
			    DIVIDE (
			        '2026_SAC'[Avance_1],
			        '2026_SAC'[Objetivos_1],
			        0
			    )
			```
		formatString: #,0.00\ %;-#,0.00\ %;#,0.00\ %
		lineageTag: d57861a9-c02d-4429-b6a5-97b890e69c14
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Presupuesto_2 = ```
			
			    DIVIDE (
			        '2026_SAC'[Avance_2],
			        '2026_SAC'[Objetivos_2],
			        0
			    )
			```
		formatString: #,0.00\ %;-#,0.00\ %;#,0.00\ %
		lineageTag: a42cd4ac-7a11-4362-98bf-cb05de59cf84
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Presupuesto_3 = ```
			
			VAR _Mora = 
			    1 - DIVIDE (
			        '2026_SAC'[Avance_3],
			        '2026_SAC'[Objetivos_3],
			        0
			    )
			Return
			IF ( 
			    _Mora < 0.1,
			    1,
			    0
			)
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 894bf137-6790-489c-8cdc-010cc4b57979
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Cuarto = ```
			
			    CALCULATE (
			        VALUES ( Fechas[NbTrimestreAño] ),
			        FILTER ( Fechas, Fechas[AñoMes] = '2026_SAC'[AñoMes] )
