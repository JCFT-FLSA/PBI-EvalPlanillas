	partition 2026_SAC-d7e4a8f1-ae2c-4934-aa54-b567679a0ca9 = calculated
		mode: import
		source = ```
				
				   UNION(
				    // Asistente de planificación - Personal que nicio como personal comercial y paso a Supply perciben vaiable hasta diciembre
				    ADDCOLUMNS( FILTER ( RH_PlanillasMensuales, RH_PlanillasMensuales[Cargo] = "JSAC" && YEAR(RH_PlanillasMensuales[AñoMes]) = 2026 ), "TKPI1", "TU1", "TKPI2", "TV6", "TKPI3", "TM3", "TKPI4", "NS", "TKPI5", BLANK()),
				    // Servicio de Atención al Cliente - Personal que nicio como personal comercial y paso a Supply perciben vaiable hasta diciembre
				    ADDCOLUMNS( FILTER ( RH_PlanillasMensuales, RH_PlanillasMensuales[Cargo] = "SAC" && YEAR(RH_PlanillasMensuales[AñoMes]) = 2026 ), "TKPI1", "TU1", "TKPI2", "TV6", "TKPI3", "TM3", "TKPI4", "NS", "TKPI5", BLANK())
				   )
				```

	annotation PBI_Id = f3b8668c9cb041d1a4e53054b8c23685

