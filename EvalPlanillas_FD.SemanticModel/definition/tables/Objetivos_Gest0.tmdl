		sourceColumn: [AñoMes]

		variation Variación
			isDefault
			relationship: fae6de56-ae1e-4220-a432-4d97bea1b9c0
			defaultHierarchy: LocalDateTable_edb7a5e7-8868-463c-95ca-0e4450596f20.'Jerarquía de fechas'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	partition Objetivos_Gest0-3da69f6e-5a01-4dac-bd29-6db7ad78c86b = calculated
		mode: import
		source = ```
				
				VAR _vendedores = 
				    DISTINCT (
				        UNION (
				            CALCULATETABLE (
				                VALUES (
				                    Ventas[Vendedor]
				                ), 
				                YEAR(ventas[fecha]) = YEAR(TODAY())
				            ), 
				            CALCULATETABLE (
				                VALUES (
				                    Objetivos[Vendedor]
				                ), 
				                Objetivos[Gestion] = YEAR(TODAY())
				            )
				        )
				    )
				
				VAR _canales = FILTER(canales, Canales[CodCanal] <> 12)
				
				VAR _sucursales = filter(sucursales, Sucursales[SucursalReg] <> 0)
				
				VAR _fechas = 
				    CALCULATETABLE (
				        VALUES (
				            Fechas[AñoMes]
				        ), 
				        Fechas[Año] = year(TODAY())
				    )
				
				RETURN
				
				SELECTCOLUMNS (
				    CROSSJOIN (
				        _Vendedores, 
				        _canales, 
				        _sucursales, 
				        Lineas, 
				        _fechas
				        ), 
				        "Canal", Canales[CodCanal], 
				        "Sucursal", Sucursales[CodSuc], 
				        "CodVendedor", Ventas[Vendedor], 
				        "Linea", Lineas[Linea], 
				        "AñoMes", Fechas[AñoMes]
				    )
				```

