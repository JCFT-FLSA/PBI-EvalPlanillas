	column KPI3_Valor = ```
			// IVT Se rige por su cartera
			VAR _Vencido = 
			    SUMX(
			        FILTER(
			            FILTER(
			                FILTER (
			                    CxC,
			                    CxC[IVT Cartera] = '2026_C11'[CodVendedor]
			                ),
			                CxC[Periodo] = ENDOFQUARTER('2026_SAC'[AñoMes])
			            ),
			            CxC[neoRangoVencido] = "Vencido"
			        ),
			        CxC[Importe]
			    )
			
			VAR _Vigente = 
			    SUMX(
			        FILTER(
			            FILTER(
			                FILTER (
			                    CxC,
			                    CxC[IVT Cartera] = '2026_C11'[CodVendedor]
			                ),
			                CxC[Periodo] = ENDOFQUARTER('2026_SAC'[AñoMes])
			            ),
			            CxC[neoRangoVencido] = "Vigente"
			        ),
			        CxC[Importe]
			    )
			
			RETURN
			
			    IF (
			        '2026_C11'[TKPI3] = BLANK(), 
			        BLANK(),
			        DIVIDE(_Vencido, _Vencido + _Vigente, -1)
			    )
			
			
			//SUMX(FILTER(FILTER(FILTER(RH_Mora, RH_Mora[Gestion] = 2023), RH_Mora[Quarto] = LEFT('2023_C11_IVT'[Cuarto], 2)), RH_Mora[Vendedor] = '2023_C11_IVT'[CodVendedor]), RH_Mora[Ratio])
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 6c2d5ea4-828f-4d33-b6ce-ffcb739edf23
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

