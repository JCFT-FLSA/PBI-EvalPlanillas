	column FactorGestActual = SUMX(FILTER('DiasValidosxMes', 'DiasValidosxMes'[Periodo] = '2026_C11'[AñoMes]), 'DiasValidosxMes'[Factor])
		lineageTag: 5d7e4a3b-dd2b-4081-9e93-c1eba3112779
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column FactorGestAnterior = SUMX(FILTER('DiasValidosxMes', 'DiasValidosxMes'[Periodo] = DATEADD('2026_C11'[AñoMes], - [Valor Gestiones Previas], YEAR)), 'DiasValidosxMes'[Factor])
		lineageTag: 53b8273e-295b-4a1e-ab33-12fd98fbb41c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Objetivos_1 = ```
			// Los objetivos son personales excepto a los especialistas que es por lineas
			VAR _Canal = 11
			    
			RETURN
			
			    IF (
			        '2026_C11'[Cargo] = "IVT-LUB",
			        SUMX(
			            FILTER(
			                Objetivos, 
			                Objetivos[Canal] = _Canal &&
			                Objetivos[Periodo] = '2026_C11'[AñoMes] &&
			                Objetivos[Regional] = '2026_C11'[Regional] &&
			                Objetivos[Linea] = "LUBRICANTES"
			            ), 
			            Objetivos[ObjetivoBs]
			        ),    
			        IF (
			            '2026_C11'[Cargo] = "IVT-HERR",
			                CALCULATE(
			                    SUM(Objetivos[ObjetivoBs]),
			                        FILTER(
			                            Objetivos, 
			                            Objetivos[Canal] = _Canal &&
			                            Objetivos[Periodo] = '2026_C11'[AñoMes] &&
			                            Objetivos[Regional] = '2026_C11'[Regional] &&
			                            OR (
			                                Objetivos[Linea] = "EQUIP.D/SEGURIDAD",
			                                Objetivos[Linea] = "EQUIP&HERRAM"
			                            )
			                        )
			                    ),
			            SUMX( // IVT, VTEC & EAGR ventas de cartera
			                FILTER(
			                    Objetivos, 
			                    Objetivos[Periodo] = '2026_C11'[AñoMes] &&
			                    Objetivos[Canal] = _Canal &&
			                    Objetivos[Vendedor] = '2026_C11'[CodVendedor]
			                ), 
			                Objetivos[ObjetivoBs]
			            )
			        )
			    )
			
			```
		lineageTag: d25bef69-0378-46cd-8ceb-f7ce1af8335c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Objetivos_2 = ```
			// Todoslos toman el obetivo de la regional
			 VAR _Canal = 11
			
			RETURN
			    IF (
			        '2026_C11'[Cargo] = "IVT-LUB",
			        SUMX(
			            FILTER(
			                Objetivos, 
			                Objetivos[Canal] = _Canal &&
			                Objetivos[Periodo] = '2026_C11'[AñoMes] &&
			                Objetivos[Linea] = "LUBRICANTES" &&
			                Objetivos[Regional] = '2026_C11'[Regional]
			            ), 
			            Objetivos[UtilidadObjBs]
			        ),    
			        IF (
			            '2026_C11'[Cargo] = "IVT-HERR",
			            SUMX(
			                FILTER(
			                    Objetivos, 
			                    Objetivos[Canal] = _Canal &&
			                    Objetivos[Periodo] = '2026_C11'[AñoMes] &&
			                    OR(
			                        Objetivos[Linea] = "EQUIP&HERRAM", 
			                        Objetivos[Linea] = "EQUIP.D/SEGURIDAD"
			                        ) &&
			                    Objetivos[Regional] = '2026_C11'[Regional]
			                ), 
			                Objetivos[UtilidadObjBs]
			            ),
			            SUMX( // IVT, VTEC & EAGR ventas de cartera
			                FILTER(
			                    Objetivos, 
			                    Objetivos[Periodo] = '2026_C11'[AñoMes] &&
			                    Objetivos[Canal] = _Canal &&
			                    Objetivos[Vendedor] = '2026_C11'[CodVendedor]
			                ), 
			                Objetivos[UtilidadObjBs]
			            )
			        )
			    )
			```
		formatString: #,0.00
		lineageTag: 17acc13c-cd41-4395-9591-fd0e5d377096
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Objetivos_3 = ```
			
			VAR _Canal = 11
			
			VAR _Cargo =
			    SWITCH(
			        '2026_C11'[Cargo],
			        "IVT-LUB", "Regional",
			        "IVT-HERR", "Regional",
			        "IVT", "Personal",
			        "EAGR", "Regional",
			        "VTEC", "Personal",
			        BLANK()
			    )
			
			
			RETURN
			    CALCULATE( // Calcula las CxC de la cartera
			        SUM(CxC[Importe]),
			        FILTER (
			            CxC,
			            CxC[Periodo] = '2026_C11'[AñoMes] &&
			            IF (
			                _Cargo = "Personal",
			                CxC[IVT Cartera]= '2026_C11'[CodVendedor],
			                RELATED(Sucursales[SucursalReg]) = '2026_C11'[Regional]
			            ) &&
			            CxC[Canal] = _Canal
			        )
			    )
			
			```
		formatString: #,0.00
		lineageTag: 32978304-962c-4cbf-8d12-54c1aa52cb50
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_1 = ```
			
			    IF( '2026_C11'[Cargo] = "IVT-LUB", 
			        SUMX(
			            FILTER(
			                Ventas,
			                RELATED(Fechas[AñoMes]) = '2026_C11'[AñoMes] &&
			                RELATED(Sucursales[SucursalReg]) = '2026_C11'[Regional] &&
			                RELATED(Materiales[Linea]) = "LUBRICANTES" &&
			                RELATED(Canales[CodCanal]) = 11
			                ),
			            Ventas[Venta]
			        ),
			        IF( '2026_C11'[Cargo] = "IVT-HERR", 
			            SUMX(
			                FILTER(
			                    Ventas, 
			                    RELATED(Canales[CodCanal]) = 11 &&
			                    RELATED(Fechas[AñoMes]) = '2026_C11'[AñoMes] &&
			                    RELATED(Sucursales[SucursalReg]) = '2026_C11'[Regional] &&
			                    OR(
			                        RELATED(Materiales[Linea]) = "EQUIP&HERRAM", 
			                        RELATED(Materiales[Linea]) = "EQUIP.D/SEGURIDAD"
			                        )
			                ), 
			                Ventas[Venta]
			            ),
			            SUMX(
			                FILTER(
			                    CarteraIVT, 
			                    CarteraIVT[Periodo] = '2026_C11'[AñoMes] &&
			                    CarteraIVT[Vendedor] = '2026_C11'[CodVendedor]
			                    ), 
			                CarteraIVT[Ventas]
			            )
			        )
			    )
			
			```
		formatString: #,0.00
		lineageTag: d71f91f5-ca8a-404a-a306-329f7981b904
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_2 = ```
			
			
			VAR _Costo2 =
			    IF( '2026_C11'[Cargo] = "IVT-LUB", 
			        SUMX(
			            FILTER(
			                Ventas,
			                RELATED(Fechas[AñoMes]) = '2026_C11'[AñoMes] &&
			                RELATED(Sucursales[SucursalReg]) = '2026_C11'[Regional] &&
			                RELATED(Materiales[Linea]) = "LUBRICANTES" &&
			                RELATED(Canales[CodCanal]) = 11
			                ),
			            Ventas[Costo]
			        ),
			        IF( '2026_C11'[Cargo] = "IVT-HERR", 
			            SUMX(
			                FILTER(
			                    Ventas, 
			                    RELATED(Canales[CodCanal]) = 11 &&
			                    RELATED(Fechas[AñoMes]) = '2026_C11'[AñoMes] &&
			                    RELATED(Sucursales[SucursalReg]) = '2026_C11'[Regional] &&
			                    OR(
			                        RELATED(Materiales[Linea]) = "EQUIP&HERRAM", 
			                        RELATED(Materiales[Linea]) = "EQUIP.D/SEGURIDAD"
			                        )
			                ), 
			                Ventas[Costo]
			            ),
			            SUMX(
			                FILTER(
			                    CarteraIVT, 
			                    CarteraIVT[Periodo] = '2026_C11'[AñoMes] &&
			                    CarteraIVT[Vendedor] = '2026_C11'[CodVendedor]
			                    ), 
			                CarteraIVT[Costo]
			            )
			        )
			    )
			
			RETURN
			
			'2026_C11'[Avance_1] - _Costo2
			```
		formatString: #,0.00
		lineageTag: 59cb4c92-6089-4cee-a975-26c8973dd205
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column Avance_3 = ```
			// Calcula el valor de la cartera VIGENTE 
			
			VAR _Canal =
			    SWITCH(
			        '2026_C11'[Cargo],
			        "IVT-LUB", 11,
			        "IVT-HERR", 11,
			        BLANK()
			    )
			RETURN
			
			    IF ( // Calcula el total de las CxC de la regional
			        NOT(ISBLANK(_Canal)),
			        CALCULATE(
			            SUM(CxC[Importe]),
			            FILTER (
			                    CxC,
			                    CxC[Periodo] = '2026_C11'[AñoMes] &&
			                    RELATED(Sucursales[SucursalReg]) = '2026_C11'[Regional] &&
			                    CxC[Rangos Vencidos] = "Vigente"
			                ),
			                CxC[Canal] = _Canal
			        ),
			        CALCULATE( // Calcula las CxC de la cartera
			            SUM(CxC[Importe]),
			            FILTER (
			                CxC,
			                CxC[Periodo] = '2026_C11'[AñoMes] &&
			                CxC[Rangos Vencidos] = "Vigente" &&
			                CxC[IVT Cartera] = '2026_C11'[CodVendedor]
			            )
			        )
			    )
			```
		formatString: #,0.00
		lineageTag: c048116d-4ed2-4e53-b2ce-7764984e99bc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Presupuesto_1 = DIVIDE('2026_C11'[Avance_1], '2026_C11'[Objetivos_1], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 95ebfaa4-bdc0-4bf8-b387-c4f604fb1484
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Presupuesto_2 = DIVIDE('2026_C11'[Avance_2], '2026_C11'[Objetivos_2], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 36469367-3d86-44a2-8413-b38d570a03eb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Presupuesto_3 = ```
			
			VAR _Mora = 
			    1 - DIVIDE (
			        '2026_C11'[Avance_3],
			        '2026_C11'[Objetivos_3],
			        0
			    )
			VAR _Valor =
			    IF (
			        _Mora >= 0.44,
			        0,
			        IF(
			            _Mora >= 0.4,
			            25 * (0.44 - _Mora),
			            IF(
			                _Mora < 0.35,
			                1.5,
			                ( 1 + 10 * ( 0.4 - _Mora) )
			
			            )
			        )
			    )
			Return
			 _Valor
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 9684c449-ba25-473c-ab96-0ea441fe02b5
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

