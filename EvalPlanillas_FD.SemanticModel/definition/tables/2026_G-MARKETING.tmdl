	column Objetivos_1 =
			
			VAR _Portafolio =
			    SWITCH(
			        '2026_G-MARKETING'[Cargo],
			        "PAUT", "RODAM. AUTOMOTRIZ",
			        "PIND", "RODAM. INDUSTRIAL",
			        "PEPP", "EQUIPOS, HERRAMIENTAS, EPP y SERVICIOS",
			        "PLUB", "LUBRICANTES (FILTROS, GRASAS, LIQUIDOS DE FRENO)",
			        BLANK()
			    )
			RETURN
			    CALCULATE(
			        SUM(Objetivos[ObjetivoBs]),
			        FILTER(
			            Objetivos,
			            Objetivos[Periodo] = '2026_G-MARKETING'[AñoMes] &&
			            IF(
			                NOT(ISBLANK(_Portafolio)),
			                RELATED(Lineas[Portafolio]) = _Portafolio,
			                TRUE()
			            )
			        )
			    )
		formatString: #,0.00
		lineageTag: 9182021b-0159-45fc-a7d9-5486b0abc28a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_1 =
			
			VAR _Portafolio =
			    SWITCH(
			        '2026_G-MARKETING'[Cargo],
			        "PAUT", "RODAM. AUTOMOTRIZ",
			        "PIND", "RODAM. INDUSTRIAL",
			        "PEPP", "EQUIPOS, HERRAMIENTAS, EPP y SERVICIOS",
			        "PLUB", "LUBRICANTES (FILTROS, GRASAS, LIQUIDOS DE FRENO)",
			        BLANK()
			    )
			RETURN
			    CALCULATE(
			        SUM(Ventas[Venta]),
			        FILTER(
			            Ventas,
			            RELATED(Fechas[AñoMes]) = '2026_G-MARKETING'[AñoMes] &&
			            IF(
			                NOT(ISBLANK(_Portafolio)),
			                RELATED(Lineas[Portafolio]) = _Portafolio,
			                TRUE()
			            )
			        )
			    )
		formatString: #,0.00
		lineageTag: d7a9d9f5-0714-43fa-94ca-6a8ab38a3be6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

