	column Costo = ```
			
			    IF (
			        '2026_G-MARKETING'[Cargo] = "PAUT",
			        CALCULATE(
			            SUM(Ventas[Costo]),
			            FILTER(
			                FILTER(
			                    Ventas,
			                    RELATED(Fechas[AñoMes]) = '2026_G-MARKETING'[AñoMes]
			                ),
			                RELATED(Materiales[Portafolio]) = "RODAM. AUTOMOTRIZ"
			            )
			        ),
			        IF (
			            '2026_G-MARKETING'[Cargo] = "PIND",
			            CALCULATE(
			                SUM(Ventas[Costo]),
			                FILTER(
			                    FILTER(
			                        Ventas,
			                        RELATED(Fechas[AñoMes]) = '2026_G-MARKETING'[AñoMes]
			                    ),
			                    RELATED(Materiales[Portafolio]) = "RODAM. INDUSTRIAL"
			                )
			            ),
			            IF (
			                '2026_G-MARKETING'[Cargo] = "PEPP",
			                CALCULATE(
			                    SUM(Ventas[Costo]),
			                    FILTER(
			                        FILTER(
			                            Ventas,
			                            RELATED(Fechas[AñoMes]) = '2026_G-MARKETING'[AñoMes]
			                        ),
			                        RELATED(Materiales[Portafolio]) = "EQUIPOS, HERRAMIENTAS, EPP y SERVICIOS"
			                    )
			                ),
			                IF (
			                    '2026_G-MARKETING'[Cargo] = "PLUB",
			                    CALCULATE(
			                        SUM(Ventas[Costo]),
			                        FILTER(
			                            FILTER(
			                                Ventas,
			                                RELATED(Fechas[AñoMes]) = '2026_G-MARKETING'[AñoMes]
			                            ),
			                            RELATED(Materiales[Portafolio]) = "LUBRICANTES (FILTROS, GRASAS, LIQUIDOS DE FRENO)"
			                        )
			                    )
			                )
			            )
			        )
			    )
			```
		formatString: #,0.00
		lineageTag: 7ccd3dff-59a6-4c59-9587-f7dbece4fedc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column KPI3_Valor = ```
			
			VAR _Vencido = 
			    SUMX(
			        FILTER(
			            FILTER(
			                CxC,
			                CxC[Periodo] = ENDOFQUARTER('2026_G-VENTAS'[AñoMes])
			            ),
			            CxC[neoRangoVencido] = "Vencido"
			        ),
			        CxC[Importe]
			    )
			
			VAR _Vigente = 
			    SUMX(
			        FILTER(
			            FILTER(
			                CxC,
			                CxC[Periodo] = ENDOFQUARTER('2026_G-VENTAS'[AñoMes])
			            ),
			            CxC[neoRangoVencido] = "Vigente"
			        ),
			        CxC[Importe]
			    )
			
			
			RETURN
			
			    IF (
			        '2026_G-MARKETING'[TKPI3] = BLANK(), 
			        BLANK(),
			        DIVIDE(_Vencido, _Vencido + _Vigente, -1)
			    )
			
			```
