	column Presupuesto_3 = ```
			// la mora no puede ser mayor al 10% de la cartera
			VAR _Calc = 
			    DIVIDE (
			        '2026_G-MARKETING'[Avance_3],
			        '2026_G-MARKETING'[Objetivos_3],
			        0
			    )
			Return
			    _Calc
