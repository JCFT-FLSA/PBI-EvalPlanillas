	column Avance_2 =
			
			VAR _Portafolio =
			    SWITCH(
			        '2026_G-MARKETING'[Cargo],
			        "PAUT", "RODAM. AUTOMOTRIZ",
			        "PIND", "RODAM. INDUSTRIAL",
			        "PEPP", "EQUIPOS, HERRAMIENTAS, EPP y SERVICIOS",
			        "PLUB", "LUBRICANTES (FILTROS, GRASAS, LIQUIDOS DE FRENO)",
			        BLANK()
			    )
			VAR _Costo =
			    CALCULATE(
			        SUM(Ventas[Costo]),
			        FILTER(
			            Ventas,
			            RELATED(Fechas[AñoMes]) = '2026_G-MARKETING'[AñoMes] &&
			            IF(
			                NOT(ISBLANK(_Portafolio)),
			                RELATED(Lineas[Portafolio]) = _Portafolio,
			                TRUE()
			            )
			        )
			    )
			RETURN
			    '2026_G-MARKETING'[Avance_1] - _Costo
		formatString: #,0.00
		lineageTag: 6cd2e64f-4df4-48f4-8bc2-e8510c1467ef
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Objetivos_3 = ```
			
			VAR _Portafolio =
			    SWITCH(
			        '2026_G-MARKETING'[Cargo],
			        "PAUT", "RODAM. AUTOMOTRIZ",
			        "PIND", "RODAM. INDUSTRIAL",
			        "PEPP", "EQUIPOS, HERRAMIENTAS, EPP y SERVICIOS",
			        "PLUB", "LUBRICANTES (FILTROS, GRASAS, LIQUIDOS DE FRENO)",
			        BLANK()
			    )
			VAR _calc1 = EOMONTH('2026_G-MARKETING'[AñoMes], -13) + 1
			VAR _calc2 = 
			    
			    IF (
			        ISBLANK(_Portafolio),
			        CALCULATE(
			            DISTINCTCOUNT(Ventas[Nit]),
			            FILTER(
			                Ventas,
			                RELATED(Fechas[AñoMes]) = _calc1 &&
			                Ventas[EsPrimeraCompra] = 1
			            )
			        ),
			        CALCULATE(
			            DISTINCTCOUNT(Ventas[Nit]),
			            FILTER(
			                Ventas,
			                RELATED(Fechas[AñoMes]) = _calc1 &&
			                RELATED(Materiales[Portafolio]) = _Portafolio &&
			                Ventas[EsPrimeraCompra] = 1
			            )
			        )
			    )
			
			RETURN
			 _calc2
			```
		formatString: 0
		lineageTag: c4927ad4-fa4c-4a58-95d3-7fb60f97e6b6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

