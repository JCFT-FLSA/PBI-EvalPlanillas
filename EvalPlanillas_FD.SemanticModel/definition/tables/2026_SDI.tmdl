	column Objetivos_1 = ```
			
			VAR _Equipo =
			    SWITCH(
			        '2026_SDI'[Cargo],
			        "IDS-LUB", "EQ. LUBRICACION",
			        "JILUB",  "EQ. LUBRICACION",
			        "TLUB",  "EQ. LUBRICACION",
			        "IDS-CONF", "EQ. CONFIABILIDAD",
			        "JICON", "EQ. CONFIABILIDAD",
			        "TCONF", "EQ. CONFIABILIDAD",
			        BLANK()
			    )
			
			RETURN
			
			    IF (
			        ISBLANK(_Equipo),
			        SUMX(
			            FILTER(
			                Objetivos, 
			                Objetivos[Periodo] = '2026_SDI'[AñoMes] &&
			                Objetivos[Linea] = "SERVICIOS" &&
			                Objetivos[Regional] = '2026_SDI'[Regional]
			            ), 
			            Objetivos[ObjetivoBs]
			        ),
			       SUMX(
			            FILTER(
			                ObjetivosSDI, 
			                ObjetivosSDI[Periodo] = '2026_SDI'[AñoMes] &&
			                ObjetivosSDI[Tipo de Servicio] = _Equipo
			            ), 
			            ObjetivosSDI[ObjetivoBs]
			        )
			    )
			```
		formatString: #,0.00
		lineageTag: afb1abc8-03fd-4b62-9878-bfff282ac4eb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Objetivos_2 = ```
			// Objetivo Grupal para todos es el objetivo de su regional
			VAR _Equipo =
			    SWITCH(
			        '2026_SDI'[Cargo],
			        "IDS-LUB", "EQ. LUBRICACION",
			        "JILUB",  "EQ. LUBRICACION",
			        "TLUB",  "EQ. LUBRICACION",
			        "IDS-CONF", "EQ. CONFIABILIDAD",
			        "JICON", "EQ. CONFIABILIDAD",
			        "TCONF", "EQ. CONFIABILIDAD",
			        BLANK()
			    )
			
			RETURN
			    IF (
			        ISBLANK(_Equipo),
			        SUMX(
			            FILTER(
			                Objetivos, 
			                Objetivos[Periodo] = '2026_SDI'[Añomes] &&
			                Objetivos[Linea] = "SERVICIOS" &&
			                Objetivos[Regional] = '2026_SDI'[Regional]
			            ), 
			            Objetivos[UtilidadObjBs]
			        ),
			       SUMX(
			            FILTER(
			                ObjetivosSDI, 
			                ObjetivosSDI[Periodo] = '2026_SDI'[Añomes] &&
			                ObjetivosSDI[Tipo de Servicio] = _Equipo
			            ), 
			            ObjetivosSDI[UtilidadObjBs]
			        )
			    )
			```
		lineageTag: c0b987a2-f153-4bf5-bb06-522d478b786b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Objetivos_3 = ```
			// Tareas
			VAR _Equipo =
			    SWITCH(
			        '2026_SDI'[Cargo],
			        "IDS-LUB", "EQ. LUBRICACION",
			        "JILUB",  "EQ. LUBRICACION",
			        "TLUB",  "EQ. LUBRICACION",
			        "IDS-CONF", "EQ. CONFIABILIDAD",
			        "JICON", "EQ. CONFIABILIDAD",
			        "TCONF", "EQ. CONFIABILIDAD",
			        BLANK()
			    )
			
			RETURN
			CALCULATE( 
			    VALUES(RH_VisitasCRM_SDI[Tareas]),
			    FILTER(
			        RH_VisitasCRM_SDI,
			        RH_VisitasCRM_SDI[Periodo] = '2026_SDI'[AñoMes] &&
			        RH_VisitasCRM_SDI[Codigo de vendedor] = '2026_SDI'[CodVendedor]
			        //RH_VisitasCRM_SDI[Equipo] = _Equipo
			    )
			)
			```
		formatString: 0
		lineageTag: a1785d62-0387-429e-ba5f-aa00725c7096
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_1 = ```
			
			
			VAR _Equipo =
			    SWITCH(
			        '2026_SDI'[Cargo],
			        "IDS-LUB", "EQ. LUBRICACION",
			        "JILUB",  "EQ. LUBRICACION",
			        "TLUB",  "EQ. LUBRICACION",
			        "IDS-CONF", "EQ. CONFIABILIDAD",
			        "JICON", "EQ. CONFIABILIDAD",
			        "TCONF", "EQ. CONFIABILIDAD",
			        BLANK()
			    )
			RETURN
			    IF(
			        ISBLANK(_Equipo),
			        SUMX(
			            FILTER(
			                Ventas, 
			                RELATED(Fechas[AñoMes]) = '2026_SDI'[AñoMes] &&
			                RELATED(Materiales[Linea]) = "SERVICIOS" &&
			                RELATED(Sucursales[SucursalReg]) = '2026_SDI'[Regional]
			            ), 
			            Ventas[Venta]
			            ),
			            SUMX(
			                FILTER(
			                    VentasSDI, 
			                    VentasSDI[AñoMes] = '2026_SDI'[AñoMes] &&
			                    VentasSDI[Eq_Trabajo] = _Equipo
			                ), 
			                VentasSDI[Venta]
			            )
			        )
			
			```
		formatString: #,0.00
		lineageTag: 2e4bb465-578c-49ca-a863-44014bd7646c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_2 = ```
			// Objetivo Grupal para todos es el resultado de su regional o el nacional si es jefe
			VAR _Equipo =
			    SWITCH(
			        '2026_SDI'[Cargo],
			        "IDS-LUB", "EQ. LUBRICACION",
			        "JILUB",  "EQ. LUBRICACION",
			        "TLUB",  "EQ. LUBRICACION",
			        "IDS-CONF", "EQ. CONFIABILIDAD",
			        "JICON", "EQ. CONFIABILIDAD",
			        "TCONF", "EQ. CONFIABILIDAD"
			    )
			
			VAR _Costo =
			    SUMX(
			        FILTER(
			            EERR,
			            IF(
			                _Equipo = "EQ. LUBRICACION",
			                OR(
			                    EERR[Estrucutra_05] = "5111000004",
			                    EERR[Estrucutra_05] = "5111000006"
			                ),
			                EERR[Estrucutra_05] = "5111000001"
			                ) &&
			                EERR[PeriodoContable] = '2026_SDI'[AñoMes] &&
			                EERR[División] <> "0910"
			        ),
			        EERR[VolumenNegocio]
			    )
			
			RETURN
			
			'2026_SDI'[Avance_1] - _Costo    
			
			```
		formatString: #,0.00
		lineageTag: 28731e6b-82ad-41cd-a0c6-1ad91a13d31c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_3 = ```
			
			
			VAR _Tareas = 
			    CALCULATE(
			        COUNT(ActividadesCRM[App ID]),
			        FILTER(
			            ActividadesCRM,
			            ActividadesCRM[Tipo Actividad] = "Tarea" &&
			            ActividadesCRM[Periodo] = '2026_SDI'[AñoMes] &&
			            ActividadesCRM[Vendedor] = '2026_SDI'[CodVendedor]
			        )
			    )
			
			RETURN
			    IF(
			        ISBLANK(_Tareas),
			        0,
			        _Tareas
			    )
			```
		formatString: #,0
		lineageTag: 98da019a-0ca7-4f86-af04-99300bdf4a11
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

