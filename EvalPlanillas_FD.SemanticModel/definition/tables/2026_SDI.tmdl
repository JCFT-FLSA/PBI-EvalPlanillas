	column Objetivos_4 = ```
			// Valor fijo hasta pr+oxima evaluacion (Abr/2025)
			VAR _Equipo =
			    SWITCH(
			        '2026_SDI'[Cargo],
			        "IDS-LUB", "EQ. LUBRICACION",
			        "JILUB",  "EQ. LUBRICACION",
			        "TLUB",  "EQ. LUBRICACION",
			        "IDS-CONF", "EQ. CONFIABILIDAD",
			        "JICON", "EQ. CONFIABILIDAD",
			        "TCONF", "EQ. CONFIABILIDAD",
			        BLANK()
			    )
			
			RETURN
			    CALCULATE(
			        VALUES( RH_VisitasCRM_SDI[Visitas]),
			        FILTER(
			            RH_VisitasCRM_SDI,
			            RH_VisitasCRM_SDI[Periodo] = [AñoMes] &&
			            RH_VisitasCRM_SDI[Equipo] = _Equipo
			        )
			    )
			
			```
		formatString: 0
		lineageTag: 9953ac12-6d15-4a5f-8b10-f3a404a0f241
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

