	column Objetivos_1 = ```
			
			IF ( 
			    '2026_G-VENTAS'[Cargo] = "GRO", 
			    SUMX(
			        FILTER(
			            FILTER(
			                Objetivos, 
			                Objetivos[Periodo] = '2026_G-VENTAS'[AñoMes]), 
			            Objetivos[Regional] = '2026_G-VENTAS'[Regional]), 
			        Objetivos[ObjetivoBs]
			    ) , 
			    SUMX(
			        FILTER(
			            Objetivos, 
			            Objetivos[Periodo] = '2026_G-VENTAS'[AñoMes]), 
			        Objetivos[ObjetivoBs]
			    ) 
			)
			```
		formatString: #,0.00
		lineageTag: ad264337-b1d0-4242-8197-7c36d35a0c67
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Objetivos_2 = ```
			// Enero 2023 = Se utiilzo el avance de ventas nacional. Se modifico en febrero.
			IF ( 
			    '2026_G-VENTAS'[Cargo] = "GRO", 
			    SUMX(
			        FILTER(
			            FILTER(
			                Objetivos, 
			                Objetivos[Periodo] = '2026_G-VENTAS'[AñoMes]), 
			            Objetivos[Regional] = '2026_G-VENTAS'[Regional]), 
			        Objetivos[UtilidadObjBs]
			    ) , 
			    SUMX(
			        FILTER(
			            Objetivos, 
			            Objetivos[Periodo] = '2026_G-VENTAS'[AñoMes]), 
			        Objetivos[UtilidadObjBs]
			    )
			)
			```
		formatString: #,0.00
		lineageTag: 0fb50f81-4b2a-4f79-b1a6-6ae40581f12c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Objetivos_3 =
			// CAlcula CxC Total
			IF (
			    '2026_G-VENTAS'[Cargo] = "GRO",
			    CALCULATE(
			        SUM(CxC[Importe]),
			        FILTER (
			            FILTER(
			                CxC,
			                CxC[Periodo] = '2026_G-VENTAS'[AñoMes]
			            ),
			            CxC[RegOfiVentas] = '2026_G-VENTAS'[Regional]
			        )
			    ),
			    CALCULATE(
			        SUM(CxC[Importe]),
			        FILTER (
			            CxC,
			            CxC[Periodo] = '2026_G-VENTAS'[AñoMes]
			        )
			    )
			)
		formatString: #,0.00
		lineageTag: 01066b52-2e74-46a5-bb19-142005f361d1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_1 = ```
			
			IF ( 
			    '2026_G-VENTAS'[Cargo] = "GRO", 
			    SUMX(
			        FILTER(
			            Ventas, 
			            RELATED(Fechas[AñoMes]) = '2026_G-VENTAS'[AñoMes] &&
			            RELATED(Sucursales[SucursalReg]) = '2026_G-VENTAS'[Regional]), 
			        Ventas[Venta]
			    ) , 
			    SUMX(
			        FILTER(
			            Ventas, 
			            RELATED(Fechas[AñoMes]) = '2026_G-VENTAS'[AñoMes]), 
			        Ventas[Venta]
			    ) 
			)
			```
		formatString: #,0.00
		lineageTag: b7f2ba71-f98e-491a-b4fc-29081b4a4121
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_2 = ```
			// Calcula el margen de utilidad bruta 
			VAR _Costo =
			    IF ( 
			        '2026_G-VENTAS'[Cargo] = "GRO", 
			        SUMX(
			            FILTER(
			                Ventas, 
			                RELATED(Fechas[AñoMes]) = '2026_G-VENTAS'[AñoMes] &&
			                RELATED(Sucursales[SucursalReg]) = '2026_G-VENTAS'[Regional]), 
			            Ventas[Costo]
			        ) , 
			        SUMX(
			            FILTER(
			                Ventas, 
			                RELATED(Fechas[AñoMes]) = '2026_G-VENTAS'[AñoMes]), 
			            Ventas[Costo]
			        )   
			    )
			RETURN
			     '2026_G-VENTAS'[Avance_1] - _Costo
			```
		formatString: #,0.00
		lineageTag: 352e8247-a46f-413a-b03b-c15ddfe66fdc
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column Avance_3 = ```
			// Calcula CxC Vigente 
			    IF (
			        '2026_G-VENTAS'[Cargo] = "GRO",
			        CALCULATE(
			            SUM(CxC[Importe]),
			            FILTER (
			                CxC,
			                CxC[Periodo] = '2026_G-VENTAS'[AñoMes] &&
			                CxC[Rangos Vencidos] = "Vigente" &&
			                CxC[RegOfiVentas] = '2026_G-VENTAS'[Regional]
			            )
			        ),
			        CALCULATE(
			            SUM(CxC[Importe]),
			            FILTER (
			                CxC,
			                CxC[Periodo] = '2026_G-VENTAS'[AñoMes] &&
			                CxC[Rangos Vencidos] = "Vigente"
			            )
			        )
			    )
			```
		formatString: #,0.00
		lineageTag: 46b01596-312d-40e4-9dfe-a5ecec031f8b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Presupuesto_1 = DIVIDE('2026_G-VENTAS'[Avance_1], '2026_G-VENTAS'[Objetivos_1], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: edc16e74-3cc0-4f8e-b522-30155de0e08d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Presupuesto_2 = DIVIDE('2026_G-VENTAS'[Avance_2], '2026_G-VENTAS'[Objetivos_2], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 57f55efa-4051-48b6-8022-2f9683e8f75e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Presupuesto_3 = ```
			// la mora no puede ser mayor al 10% de la cartera
			VAR _Mora = 
			    1 - DIVIDE (
			        '2026_G-VENTAS'[Avance_3],
			        '2026_G-VENTAS'[Objetivos_3],
			        0
			    )
			VAR _Valor =
			    IF (
			        _Mora >= 0.44,
			        0,
			        IF(
			            _Mora >= 0.4,
			            25 * (0.44 - _Mora),
			            IF(
			                _Mora < 0.35,
			                1.5,
			                ( 1 + 10 * ( 0.4 - _Mora) )
			            )
			        )
			    )
			Return
			    _Valor * 0.1
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 30a82506-f29a-4f0a-8470-e05ec2a071ec
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column Cuarto = CALCULATE(VALUES(Fechas[NbTrimestreAño]), filter(Fechas, Fechas[AñoMes] = '2026_G-VENTAS'[AñoMes]))
