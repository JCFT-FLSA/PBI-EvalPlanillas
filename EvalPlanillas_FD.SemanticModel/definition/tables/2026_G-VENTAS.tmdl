		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column FactorGestAnterior = SUMX(FILTER('DiasValidosxMes', 'DiasValidosxMes'[Periodo] = DATEADD('2026_C11'[AñoMes], - [Valor Gestiones Previas], YEAR)), 'DiasValidosxMes'[Factor])
		lineageTag: b0d081d1-c63b-407b-a2a3-dbae214f6d11
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

