	column TKPI3
		lineageTag: 8e5753bf-fc49-42db-8f56-72054b59b7b8
		summarizeBy: none
		isNameInferred
		sourceColumn: [TKPI3]

		annotation SummarizationSetBy = Automatic

	column KPI3_Valor = ```
			
			VAR _Vencido = 
			    SUMX(
			        FILTER(
			            FILTER(
			                CxC,
			                CxC[Periodo] = ENDOFQUARTER('2026_G-VENTAS'[AñoMes])
			            ),
			            CxC[neoRangoVencido] = "Vencido"
			        ),
			        CxC[Importe]
			    )
			
			VAR _Vigente = 
			    SUMX(
			        FILTER(
			            FILTER(
			                CxC,
			                CxC[Periodo] = ENDOFQUARTER('2026_G-VENTAS'[AñoMes])
			            ),
			            CxC[neoRangoVencido] = "Vigente"
			        ),
			        CxC[Importe]
			    )
			
			VAR _Vencido_C11 =
			    SUMX(
			        FILTER(
			            FILTER (
			                FILTER(
			                    CxC,
			                    CxC[Periodo] = ENDOFQUARTER('2026_G-VENTAS'[AñoMes])
			                ),
			                CxC[Canal] = 11
			            ),
			            CxC[neoRangoVencido] = "Vencido"
			        ),
			        CxC[Importe]
			    )
			
			VAR _Vencido_C20 =
			    SUMX(
			        FILTER(
			            FILTER (
			                FILTER(
			                    CxC,
			                    CxC[Periodo] = ENDOFQUARTER('2026_G-VENTAS'[AñoMes])
			                ),
			                CxC[Canal] = 20
			            ),
			            CxC[neoRangoVencido] = "Vencido"
			        ),
			        CxC[Importe]
			    )
			
			VAR _Vigente_C11 =
			    SUMX(
			        FILTER(
			            FILTER (
			                FILTER(
			                    CxC,
			                    CxC[Periodo] = ENDOFQUARTER('2026_G-VENTAS'[AñoMes])
			                ),
			                CxC[Canal] = 11
			            ),
			            CxC[neoRangoVencido] = "Vigente"
			        ),
			        CxC[Importe]
			    )
			
			VAR _Vigente_C20 =
			    SUMX(
			        FILTER(
			            FILTER (
			                FILTER(
			                    CxC,
			                    CxC[Periodo] = ENDOFQUARTER('2026_G-VENTAS'[AñoMes])
			                ),
			                CxC[Canal] = 20
			            ),
			            CxC[neoRangoVencido] = "Vigente"
			        ),
			        CxC[Importe]
			    )
			
			VAR _Vencido_GRO = 
			    SUMX(
			        FILTER(
			            FILTER(
			                FILTER(
			                    CxC,
			                    CxC[RegOfiVentas] = '2026_G-VENTAS'[Regional]
			                    //RELATED(Sucursales[SucursalReg]) = '2023_GERENTES'[Regional]
			                ),
			                CxC[Periodo] = ENDOFQUARTER('2026_G-VENTAS'[AñoMes])
			            ),
			            CxC[neoRangoVencido] = "Vencido"
			        ),
			        CxC[Importe]
			    )
			
			VAR _Vigente_GRO = 
			    SUMX(
			        FILTER(
			            FILTER(
			                FILTER(
			                    CxC,
			                    CxC[RegOfiVentas] = '2026_G-VENTAS'[Regional]
			                    //RELATED(Sucursales[SucursalReg]) = '2023_GERENTES'[Regional]
			                ),
			                CxC[Periodo] = ENDOFQUARTER('2026_G-VENTAS'[AñoMes])
			            ),
			            CxC[neoRangoVencido] = "Vigente"
			        ),
			        CxC[Importe]
			    )
			
			RETURN
			
			    IF (
			        '2026_G-VENTAS'[TKPI3] = BLANK(), 
			        BLANK(),
			        IF (
			            '2026_G-VENTAS'[Cargo] = "GRO",
			            DIVIDE(_Vencido_GRO, _Vencido_GRO + _Vigente_GRO, -1),
			            IF (
			                OR('2026_G-VENTAS'[Cargo] = "JVN", '2026_G-VENTAS'[Cargo] = "GB2B"),
			                DIVIDE( _Vencido_C11, _Vencido_C11 + _Vigente_C11, -1),
			                IF (
			                    OR('2026_G-VENTAS'[Cargo] = "JCI", '2026_G-VENTAS'[Cargo] = "GB2C"),
			                    DIVIDE( _Vencido_C20, _Vencido_C20 + _Vigente_C20, -1),
			                    DIVIDE(_Vencido, _Vencido + _Vigente, -1)
			            )
			        )
			    ))
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 1990e536-29e1-4b75-8f87-ce6a7e15d3d2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

