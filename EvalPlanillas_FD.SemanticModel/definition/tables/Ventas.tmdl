	column EsPrimeraCompra =
			
			IF(
			    Ventas[Fecha] =
			        CALCULATE(
			            MIN( Ventas[Fecha] ),
			            ALLEXCEPT( Ventas, Ventas[Nit] )
			        ),
			    1,
			    0
			)
		formatString: 0
		lineageTag: 9d9bcd3e-918c-4f0b-a755-53774b1ceb71
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

