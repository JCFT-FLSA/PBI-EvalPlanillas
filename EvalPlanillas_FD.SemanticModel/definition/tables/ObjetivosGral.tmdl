	column Avance = ```
			
			    SUMX(
			        FILTER(
			            FILTER(
			                FILTER(
			                    FILTER(
			                        FILTER(
			                            Ventas, 
			                            RELATED(Sucursales[CodSuc]) = ObjetivosGral[Sucursal]
			                        ),
			                        RELATED(Canales[CodCanal]) = ObjetivosGral[Canal]
			                    ), 
			                    RELATED(Fechas[AñoMes]) = ObjetivosGral[AñoMes]
			                ), 
			                RELATED(Lineas[Linea]) = ObjetivosGral[Linea]
			            ), 
			            Ventas[Vendedor] = ObjetivosGral[CodVendedor]
			        ), 
			        Ventas[Venta]
			    )
			```
		lineageTag: e403f5bc-8b2a-4036-97db-a20ebf801f9c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Presupuesto = sumx(filter(filter(FILTER(FILTER(filter(Objetivos, Objetivos[Canal] = ObjetivosGral[Canal]), Objetivos[Sucursal] = ObjetivosGral[Sucursal]), Objetivos[Vendedor] = ObjetivosGral[CodVendedor]), Objetivos[Linea] = ObjetivosGral[Linea]), Objetivos[GestionMes] = ObjetivosGral[AñoMes]), Objetivos[Objetivo])
		lineageTag: b02499c4-48a6-4518-a41b-71e536135ca4
		summarizeBy: sum

