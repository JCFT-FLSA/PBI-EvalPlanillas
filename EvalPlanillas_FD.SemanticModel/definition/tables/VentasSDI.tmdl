		isNameInferred
		sourceColumn: MaterialesSDI[Eq_Trabajo]

		annotation SummarizationSetBy = Automatic

	partition VentasSDI = calculated
		mode: import
		source = ```
				
				    CROSSJOIN( 
				        'FechasAñoMes', 
				        MaterialesSDI, 
				        SELECTCOLUMNS (
				            FILTER(
				                Regionales, 
				                Regionales[CodRegional] > 0
				            ),
				            "Regional", Regionales[CodRegional]
				        )
				    )
				```

	annotation PBI_Id = 7d63cf16fa914f9784a4674aad49c761

