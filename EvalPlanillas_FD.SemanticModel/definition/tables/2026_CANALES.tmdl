	column Objetivos_2 =
			// Enero 2023 = Se utiilzo el avance de ventas nacional. Se modifico en febrero.
			VAR _Canal =
			    SWITCH(
			        '2026_CANALES'[Cargo],
			        "JPDV", 10,
			        "JVN", 11,
			        "JCI", 20,
			        "JC10R", 10,
			        BLANK()
			    )
			RETURN
			    IF(
			        '2026_CANALES'[Cargo] = "JC10R",
			        CALCULATE(
			            SUM(Objetivos[UtilidadObjBs]),
			            FILTER(
			                Objetivos,
			                Objetivos[Periodo] = '2026_CANALES'[AñoMes] &&
			                Objetivos[Canal] = _Canal &&
			                Objetivos[Regional] = '2026_CANALES'[Regional]
			            )
			        ),
			        CALCULATE(
			            SUM(Objetivos[UtilidadObjBs]),
			            FILTER(
			                Objetivos,
			                Objetivos[Periodo] = '2026_CANALES'[AñoMes] &&
			                Objetivos[Canal] = _Canal
			            )
			        )
			    )
		formatString: #,0.00
		lineageTag: 0709e4ba-4f83-4b5c-9928-84f8d83ebb28
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_2 = ```
			
			VAR _Canal =
			    SWITCH(
			        '2026_CANALES'[Cargo],
			        "JPDV", 10,
			        "JVN", 11,
			        "JCI", 20,
			        "JC10R", 10,
			        BLANK()
			    )
			VAR _Costo =
			    IF(
			        '2026_CANALES'[Cargo] = "JC10R",
			        CALCULATE(
			            SUM(Ventas[Costo]),
			            FILTER(
			                Ventas,
			                RELATED(Fechas[AñoMes]) = '2026_CANALES'[AñoMes] &&
			                RELATED(Canales[CodCanal]) = _Canal &&
			                RELATED(Sucursales[SucursalReg]) = '2026_CANALES'[Regional]
			            )
			        ),
			        CALCULATE(
			            SUM(Ventas[Costo]),
			            FILTER(
			                Ventas,
			                RELATED(Fechas[AñoMes]) = '2026_CANALES'[AñoMes] &&
			                RELATED(Canales[CodCanal]) = _Canal
			            )
			        )
			    )
			RETURN
			    '2026_CANALES'[Avance_1] - _Costo
			
			```
		formatString: #,0.00
		lineageTag: 20c61eee-94d1-4ad9-bb14-c720a53e1abd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Objetivos_3 = ```
			
			VAR _Canal = 
			    SWITCH(
			        '2026_CANALES'[Cargo],
			        "JPDV", 10,
			        "JVN", 11,
			        "JCI", 20,
			        "JC10R", 10,
			        BLANK()
			    )
			
			VAR _calc1 = EOMONTH('2026_CANALES'[AñoMes], -13) + 1
			VAR _calc2 = 
			    
			    IF (
			        '2026_CANALES'[Cargo] = "JC10R",
			        CALCULATE(
			            DISTINCTCOUNT(Ventas[Nit]),
			            FILTER(
			                Ventas,
			                RELATED(Fechas[AñoMes]) = _calc1 &&
			                RELATED(Sucursales[SucursalReg]) = '2026_CANALES'[Regional] &&
			                Ventas[Canal distribución] = _Canal &&
			                Ventas[EsPrimeraCompra] = 1
			            )
			        ),
			        CALCULATE(
			            DISTINCTCOUNT(Ventas[Nit]),
			            FILTER(
			                Ventas,
			                RELATED(Fechas[AñoMes]) = _calc1 &&
			                Ventas[Canal distribución] = _Canal &&
			                Ventas[EsPrimeraCompra] = 1
			            )
			        )
			    )
			
			RETURN
			 _calc2
			```
		formatString: #,0
		lineageTag: 554ebeb4-00e8-42a3-8627-327b822474f8
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

