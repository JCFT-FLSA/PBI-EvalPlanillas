	column Objetivos_1 =
			
			VAR _Canal =
			    SWITCH(
			        '2026_CANALES'[Cargo],
			        "JPDV", 10,
			        "JVN", 11,
			        "JCI", 20,
			        "JC10R", 10,
			        BLANK()
			    )
			RETURN
			    IF(
			        '2026_CANALES'[Cargo] = "JC10R",
			        CALCULATE(
			            SUM(Objetivos[ObjetivoBs]),
			            FILTER(
			                Objetivos,
			                Objetivos[Periodo] = '2026_CANALES'[AñoMes] &&
			                Objetivos[Canal] = _Canal &&
			                Objetivos[Regional] = '2026_CANALES'[Regional]
			            )
			        ),
			        CALCULATE(
			            SUM(Objetivos[ObjetivoBs]),
			            FILTER(
			                Objetivos,
			                Objetivos[Periodo] = '2026_CANALES'[AñoMes] &&
			                Objetivos[Canal] = _Canal
			            )
			        )
			    )
		formatString: #,0.00
		lineageTag: 082defa1-9a91-46a1-898b-2c99ddd2ed3e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Avance_1 =
			
			VAR _Canal =
			    SWITCH(
			        '2026_CANALES'[Cargo],
			        "JPDV", 10,
			        "JVN", 11,
			        "JCI", 20,
			        "JC10R", 10,
			        BLANK()
			    )
			RETURN
			    IF(
			        '2026_CANALES'[Cargo] = "JC10R",
			        CALCULATE(
			            SUM(Ventas[Venta]),
			            FILTER(
			                Ventas,
			                RELATED(Fechas[AñoMes]) = '2026_CANALES'[AñoMes] &&
			                RELATED(Canales[CodCanal]) = _Canal &&
			                RELATED(Sucursales[SucursalReg]) = '2026_CANALES'[Regional]
			            )
			        ),
			        CALCULATE(
			            SUM(Ventas[Venta]),
			            FILTER(
			                Ventas,
			                RELATED(Fechas[AñoMes]) = '2026_CANALES'[AñoMes] &&
			                RELATED(Canales[CodCanal]) = _Canal
			            )
			        )
			    )
		formatString: #,0.00
		lineageTag: 7e355b01-7395-4dd7-89e3-c6c7079a0bac
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Cuarto = CALCULATE(VALUES(Fechas[NbTrimestreAño]), filter(Fechas, Fechas[AñoMes] = '2026_CANALES'[AñoMes]))
